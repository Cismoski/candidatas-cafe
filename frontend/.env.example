# Copie para .env.local e preencha. Valores aqui são públicos no bundle
# (VITE_*): nunca coloque segredos. A chave do Gemini fica só no backend.

# URL base da API (sem barra no final)
VITE_API_URL=
# OAuth Client ID do Google (o mesmo GOOGLE_CLIENT_ID do backend; é público)
VITE_GOOGLE_CLIENT_ID=
