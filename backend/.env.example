# Copie para .env e preencha. Nunca commite o .env.

# --- Autenticação -------------------------------------------------------------
# OAuth Client ID (tipo "Aplicativo da Web") do Google Cloud Console
GOOGLE_CLIENT_ID=
# Segredo do JWT da aplicação (>= 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60

# --- Rede -------------------------------------------------------------------
# Origens do frontend permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Proxies confiáveis que acrescentam ao X-Forwarded-For (0 = local, Render = 1)
TRUSTED_PROXY_HOPS=0

# --- Armazenamento e uploads --------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=40
MAX_RASTER_DIM=1500
UPLOADS_PER_DAY=10

# --- Processamento ------------------------------------------------------------
JOB_TIMEOUT_SECONDS=300
MAX_QUEUED_JOBS=4

# --- Retenção -----------------------------------------------------------------
RETENTION_HOURS=24
RETENTION_SWEEP_MINUTES=15
USER_RETENTION_DAYS=30

# --- Chat (fase 4) ------------------------------------------------------------
GEMINI_API_KEY=
CHAT_MESSAGES_PER_DAY=30
