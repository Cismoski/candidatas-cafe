# Copie para .env e preencha. Nunca commite o .env.

# --- Autenticação -------------------------------------------------------------
# OAuth Client ID (tipo "Aplicativo da Web") do Google Cloud Console
GOOGLE_CLIENT_ID=
# Segredo do JWT da aplicação (>= 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60

# --- Rede -------------------------------------------------------------------
# Origens do frontend permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Proxies confiáveis que acrescentam ao X-Forwarded-For (0 = local, Render = 1)
TRUSTED_PROXY_HOPS=0

# --- Armazenamento e uploads --------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=40
MAX_RASTER_DIM=1500
UPLOADS_PER_DAY=10

# --- Processamento ------------------------------------------------------------
JOB_TIMEOUT_SECONDS=300
MAX_QUEUED_JOBS=4

# --- Retenção -----------------------------------------------------------------
RETENTION_HOURS=24
RETENTION_SWEEP_MINUTES=15
USER_RETENTION_DAYS=30

# --- Assistente --------------------------------------------------------------
# Chave do Google AI Studio. Vazia = só respostas automáticas (determinísticas).
# Atenção: no free tier o Google pode usar prompts/respostas para melhorar
# produtos; o backend envia só números da análise e a pergunta.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
CHAT_MESSAGES_PER_DAY=30
# Chamadas simultâneas ao Gemini; acima disso a resposta é automática
CHAT_MAX_CONCURRENT=4
# Circuit breaker: N falhas seguidas do Gemini => respostas automáticas por N s
CHAT_BREAKER_FAILURES=3
CHAT_BREAKER_COOLDOWN_SECONDS=120
